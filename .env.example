# FuelRoute Environment Configuration Example
DEBUG=True
SECRET_KEY=django-insecure-fuelroute-change-this-in-production-assessment-key
ALLOWED_HOSTS=localhost,127.0.0.1,*
DATABASE_URL=sqlite:///db.sqlite3

# External Routing Service
OSRM_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_SECONDS=10
ROUTING_MAX_RETRIES=2

# Optimization Parameters
MAX_DETOUR_MILES=5.0
DETOUR_PENALTY_ENABLED=True
DEFAULT_MPG=10.0
TANK_CAPACITY_GALLONS=50.0

# Geocoding & Cache
NOMINATIM_FALLBACK_ENABLED=False
CACHE_TTL=86400

